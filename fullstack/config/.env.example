# Configuración de ApuntIA para los scripts de arranque (fullstack/scripts) y Docker.
# iniciar.sh / iniciar.bat la copian a fullstack/config/.env la primera vez; edita esa copia.
# NO subas fullstack/config/.env al repositorio. Las variables definidas en el entorno tienen
# prioridad. Referencia completa: back/motori_magenes/.env.example y docs/arranque.md.

# Puerto de la aplicación: interfaz (/inicio, /front/...) y API en el mismo origen.
APUNTIA_PUERTO=8000

# Carpeta privada de datos (SQLite y archivos de los usuarios), relativa a back/motori_magenes.
# Nunca dentro de front/. Copias de seguridad: fullstack/scripts/respaldar.sh (FULL-23).
DATA_DIR=datos

# Reconocimiento de texto: tesseract | ninguno. Idiomas de Tesseract separados por «+».
OCR_MOTOR=tesseract
OCR_IDIOMAS=spa+eng

# Reconocimiento adaptativo (BACK-28): adaptativo | clasico (el flujo anterior, para comparar
# o volver atrás). Límites por página: variantes por bloque dudoso, bloques releídos y segundos.
RECONOCIMIENTO_MODO=adaptativo
RECONOCIMIENTO_MAX_VARIANTES=4
RECONOCIMIENTO_MAX_BLOQUES=60
RECONOCIMIENTO_MAX_SEGUNDOS=30

# IA local opcional (FULL-30, docs/ia-local.md). Desactivada: ApuntIA funciona igual sin ella.
# El modelo lo instala quien administra el equipo («ollama pull qwen3-vl:4b»); ApuntIA nunca lo descarga.
IA_ACTIVADA=false
OLLAMA_HOST=http://127.0.0.1:11434
VLM_MODELO=qwen3-vl:4b
IA_TIMEOUT_S=180
IA_MAX_INFERENCIAS=1
# rapido | equilibrado | avanzado | automatico
RECONOCIMIENTO_PERFIL=automatico
# Solo true si aceptas que las fotos salgan de tu red (servidor público o modelos «-cloud»).
IA_PERMITIR_EXTERNA=false

# Límites
MAX_UPLOAD_MB=10
MAX_PAGINAS=20
MAX_TRABAJOS_SIMULTANEOS=2
CUOTA_MB_USUARIO=500
# Cuentas nuevas por IP y hora (súbelo si toda una clase se registra desde la misma red).
MAX_REGISTROS_HORA=10

# Cookie de sesión con Secure: 1 SOLO si la aplicación se sirve por HTTPS (p. ej. detrás de un proxy).
COOKIE_SEGURA=0
# URL pública para los enlaces de recuperación de contraseña (recomendado en producción).
URL_PUBLICA=

# Información complementaria externa: wikipedia | ninguno (sin Internet). Aunque esté activa,
# cada persona debe permitirla en su perfil y confirmar cada búsqueda.
INVESTIGACION_PROVEEDOR=wikipedia
