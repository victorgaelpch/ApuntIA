# Copia este archivo como .env y ajusta los valores. No subas .env al repositorio.

# Límites de las imágenes recibidas
MAX_UPLOAD_MB=10
MAX_MEGAPIXELES=50

# Lado mayor con el que se procesa la imagen (0 = sin límite)
MAX_LADO_PROCESAMIENTO=2000

# Orígenes permitidos por CORS, separados por comas ("*" = todos)
CORS_ORIGINS=*

# Nombre mostrado en la documentación de la API
APP_NAME=ApuntIA - Motor de imágenes

# Carpeta privada de datos: base de datos y archivos de los usuarios (BACK-22)
DATA_DIR=datos

# Cookie de sesión con el atributo Secure: actívalo (1) solo si sirves ApuntIA por HTTPS (BACK-23)
COOKIE_SEGURA=0

# Procesos largos (OCR, PDF) ejecutados a la vez y páginas por apunte (BACK-27, BACK-11)
MAX_TRABAJOS_SIMULTANEOS=2
MAX_PAGINAS=20
# Investigación opcional (BACK-18): wikipedia | ninguno (sin Internet)
INVESTIGACION_PROVEEDOR=wikipedia
INVESTIGACION_TIMEOUT_S=6
# Endurecimiento (BACK-24): cuerpo JSON máximo (KB) y espacio por usuario (MB)
MAX_JSON_KB=4096
CUOTA_MB_USUARIO=500
# Cuentas nuevas por IP y hora (súbelo si toda una clase se registra desde la misma red)
MAX_REGISTROS_HORA=10
# URL pública para los enlaces de recuperación de contraseña (recomendado en producción)
URL_PUBLICA=
