# Configuración del servidor IA (BACK-35). Copia de ejemplo SIN secretos.
# Los valores por defecto ya son los recomendados para una RTX 3060 de 12 GB.

# Dónde escucha este servicio. Solo se permite 127.0.0.1 hasta que exista la vinculación
# autenticada de dispositivos (FULL-31); desde otra red se llega por el túnel.
IA_HOST=127.0.0.1
IA_PUERTO=8100

# Ollama: siempre en este mismo equipo (loopback). Nunca exponer el puerto 11434.
IA_OLLAMA_URL=http://127.0.0.1:11434
IA_MODELO=qwen3-vl:8b
# Perfil de menor consumo que se usa una vez si el principal no cabe en la VRAM (vacío = no usar)
IA_MODELO_RESPALDO=qwen3-vl:4b
IA_KEEP_ALIVE=10m
# Contexto (tokens) y tope de tokens generados por imagen (medido: con el contexto por defecto
# de Ollama, 4096, las fórmulas se cortaban)
IA_NUM_CTX=8192
IA_MAX_TOKENS=2048

# Límites
IA_MAX_MB=10
IA_MAX_MEGAPIXELES=40
IA_MAX_LADO_MODELO=1600
IA_MAX_INFERENCIAS=1
IA_ESPERA_COLA_S=20
IA_TIMEOUT_S=180
IA_MIN_DISCO_MB=2048
